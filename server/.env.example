NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:8080
MONGODB_URI=mongodb://localhost:27017/wwzhidao
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
AI_PROVIDER=deepseek
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=4000
AI_MAX_RETRIES=2
AI_TIMEOUT_MS=60000
AI_INPUT_COST_PER_MILLION=0
AI_OUTPUT_COST_PER_MILLION=0
AI_CACHE_ENABLED=true
AI_CACHE_TTL_SECONDS=86400
AI_CACHE_MAX_VALUE_BYTES=1000000
AI_BATCH_POLL_MS=30000
AI_BATCH_LEASE_MS=300000
AI_BATCH_CONCURRENCY=3
REPORT_RETRY_POLL_MS=30000
REPORT_RETRY_LEASE_MS=300000
REPORT_RETRY_BASE_MS=60000
REPORT_RETRY_MAX_DELAY_MS=3600000
REPORT_RETRY_MAX_ATTEMPTS=5
REPORT_RETRY_BATCH_SIZE=10
ALERT_RELAY_TOKEN=
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
RAG_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=interview_knowledge
QDRANT_TIMEOUT_MS=10000
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_MS=30000
AI_CONVERSATION_SUMMARY_THRESHOLD=30
AI_SESSION_CLEANUP_INTERVAL_MS=600000

# 微信服务号登录
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_TOKEN=
WECHAT_WEB_URL=https://example.com
WECHAT_RESUME_URL=https://example.com/resume
WECHAT_MENU_IMAGE_PATH=public/imgs/wechat.jpg

# OSS STS，启用时必须整组填写
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_STS_ROLE_ARN=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_REGION=
ALIYUN_STS_ENDPOINT=https://sts.aliyuncs.com/

# 支付宝，启用时必须整组填写
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# 微信支付，启用时必须整组填写
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_MCH_SERIAL=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_PLATFORM_PUBLIC_KEY=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_NOTIFY_URL=
WECHAT_PAY_API_BASE=https://api.mch.weixin.qq.com

# 只允许非生产环境显式开启
PAYMENT_TEST_MODE=false

# 结构化日志
LOG_LEVEL=debug
LOG_FILE_ENABLED=false
LOG_DIR=logs
SWAGGER_ENABLED=true
SWAGGER_PATH=api-docs
